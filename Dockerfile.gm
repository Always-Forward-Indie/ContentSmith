FROM node:18-alpine AS builder
WORKDIR /app
COPY . .
RUN npm ci && npm run build --workspace=@contentsmith/gm-panel

FROM node:18-alpine AS runner
WORKDIR /app
COPY --from=builder /app/apps/gm-panel/.next/standalone /app
COPY --from=builder /app/apps/gm-panel/.next/static /app/apps/gm-panel/.next/static
ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001
CMD ["node", "apps/gm-panel/server.js"]
