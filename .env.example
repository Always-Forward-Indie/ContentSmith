# =============================================================================
# ContentSmith — Environment Variables
# Copy to .env and fill in real values before deployment
# =============================================================================

# ─── Database ──────────────────────────────────────────────────────────────────
# Docker production: container connects via docker-compose network (mmo_network).
# The defaults below match the docker-compose.yml fallback values.
# For local dev without Docker, replace host with localhost or host.docker.internal.
DATABASE_URL=postgresql://user:password@mmorpg_prototype_db:5432/mmo_prototype
GAME_DATABASE_URL=postgresql://user:password@mmorpg_prototype_db:5432/mmo_prototype

# ─── Studio (port 3000) ───────────────────────────────────────────────────────
STUDIO_PORT=3000
STUDIO_NEXTAUTH_URL=http://localhost:3000
STUDIO_NEXTAUTH_SECRET=generate-a-random-string-at-least-32-chars-long

# ─── GM Panel (port 3001) ─────────────────────────────────────────────────────
GM_PANEL_PORT=3001
GM_NEXTAUTH_URL=http://localhost:3001
GM_NEXTAUTH_SECRET=generate-another-random-string-at-least-32-chars-long
